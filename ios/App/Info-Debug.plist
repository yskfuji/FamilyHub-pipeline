<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug だけ: 同じ Mac のシミュレーターの試験で、平文の http（127.0.0.1）を使う。アプリの APIClient も loopback 以外の http は断る。 -->
	<key>FHDevServerURL</key>
	<string>$(FH_DEV_SERVER_URL)</string>
	<!-- Info.plist と同じ値。Debug はこの plist だけを使うので、足りないと位置の許可を求めたときにアプリが止まる。 -->
	<key>FHPasskeyRelyingParty</key>
	<string>$(FH_ASSOCIATED_DOMAIN)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>支出やメモに場所を付けるとき、近くのお店の候補を出すために使います。正確な現在地は端末の中だけで使い、外部へは約100m単位に丸めた位置だけを送ります。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>同じ Wi-Fi にある手元の開発サーバーにつなぐために使います。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
