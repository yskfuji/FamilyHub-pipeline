<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug だけ: 同じ Mac のシミュレーターの試験で、平文の http（127.0.0.1）を使う。アプリの APIClient も loopback 以外の http は断る。 -->
	<key>FHDevServerURL</key>
	<string>$(FH_DEV_SERVER_URL)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>同じ Wi-Fi にある手元の開発サーバーにつなぐために使います。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
