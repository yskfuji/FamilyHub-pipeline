// 全体の設定。チーム ID とバンドルの接頭辞は、リポジトリに入れない Local.xcconfig で上書きする（docs/ios/README.md）。
FH_BUNDLE_PREFIX = example.familyhub
FH_TEAM_ID =
// 手元の開発サーバー（npm run dev:lan が表示する URL）。空なら見本だけ。xcconfig では // が注釈になるので https:/$()/ と書く。
FH_DEV_SERVER_URL =
// パスキーを使うドメイン（webcredentials）。空ならパスキーの追加を出さない。使うときは entitlement の associated-domains にも webcredentials:<ドメイン> を足す（docs/ios/README.md）。
FH_ASSOCIATED_DOMAIN =

IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1,2
DEVELOPMENT_TEAM = $(FH_TEAM_ID)
CODE_SIGN_STYLE = Automatic

#include? "Local.xcconfig"
