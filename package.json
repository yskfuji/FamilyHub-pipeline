{
  "name": "family-hub-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test e2e/core.spec.ts",
    "audit:a11y": "playwright test e2e/accessibility.spec.ts",
    "audit:visual": "playwright test e2e/capture.spec.ts --project=chromium && node scripts/build-gallery.mjs",
    "audit:lighthouse": "bash scripts/lighthouse.sh",
    "audit:security": "node scripts/security-check.mjs",
    "render:er": "node scripts/render-er.mjs",
    "build:gallery": "node scripts/build-gallery.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run audit:security && npm run audit:lighthouse && npm run test:e2e && npm run audit:a11y",
    "package": "npm run verify && npm run render:er && npm run audit:visual && bash scripts/package.sh"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.2.8",
    "@fontsource-variable/noto-serif-jp": "5.2.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.59.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.4.0",
    "jsdom": "27.2.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.0.4",
    "vitest": "4.1.11"
  }
}
