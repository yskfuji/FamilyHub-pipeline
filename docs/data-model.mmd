%% バックアップの実行は表に残さない（運用ログと、置き場所の目録に残す）。計画の BACKUP_RUNS は作っていない。
%% 成人の申告は users.adult_declared_at（見本のデータでは利用者ごとの adultDeclared）。
erDiagram
  users ||--o| household_members : belongs_through
  users ||--o{ sessions : owns
  users ||--o{ passkeys : registers
  users ||--o{ recovery_codes : holds
  users ||--o{ password_resets : requests
  users ||--o{ uploads : sends
  users ||--o{ assistant_jobs : starts
  key_fingerprints ||--o{ users : seals_totp_secret
  household_members }o--|| records : household_id
  records ||--o{ entitlements : household_id
  records ||--o{ audit_outbox : household_id
  audit_outbox ||--o| audit_events : moves_to_audit_db
  audit_events ||--o{ audit_anchors : anchored_daily
  audit_events ||--o{ audit_checkpoints : pruned_through
  records ||--o{ memberships : collection
  records ||--o{ events : collection
  records ||--o{ todos : collection
  records ||--o{ memos : collection
  records ||--o{ expenses : collection
  records ||--o{ settlementBatches : collection
  settlementBatches ||--o{ expenses : settles_shares_of
  records ||--o{ resources : collection
  records ||--o{ links : collection
  records ||--o{ colorLabels : collection
  records ||--o{ invites : collection
  records ||--o{ notifications : collection
  records ||--o{ permissionOverrides : collection
  records ||--o{ albums : collection
  records ||--o{ albumItems : collection
  records ||--o{ archive : collection
  records ||--o{ meta : collection
  albums ||--o{ albumItems : album_id
  uploads }o--|| albumItems : item_id
  assistant_jobs }o--|| records : household_id

  users {
    text id PK
    text email UK "大文字小文字を区別しない"
    text display_name
    text avatar_tone
    text password_hash "Argon2id の値"
    text created_at
    text deleted_at
    text birthdate
    text adult_declared_at
    text avatar
    integer idle_timeout_minutes
    text totp_secret "v2.kid.iv.tag.本文 の形で暗号化して保存"
    text totp_enabled_at
    integer totp_last_step "再利用の防止"
  }
  household_members {
    text user_id PK,FK
    text household_id
    text membership_id UK
  }
  records {
    text household_id PK
    text collection PK "下の JSON 文書の種類"
    text id PK
    integer seq "配列の順"
    text body "JSON 文書"
  }
  sessions {
    text id PK
    text token_hash UK
    text user_id FK
    text label
    text location
    text created_at
    text last_seen_at
    text expires_at
    text reauthenticated_at
    text revoked_at
  }
  passkeys {
    text id PK
    text user_id FK
    text credential_id UK
    blob public_key
    integer counter
    text transports
    text label
    text created_at
  }
  webauthn_challenges {
    text id PK
    text purpose
    text user_id
    text challenge
    text expires_at
  }
  idempotency_records {
    text scope PK
    text key PK
    text request_hash
    integer status
    text body
    text created_at
  }
  rate_limits {
    text bucket PK
    integer count
    integer window_started_at
  }
  audit_outbox {
    integer seq PK "本体の DB。変更と同じトランザクションで書く"
    text id UK "audit.db へ INSERT OR IGNORE で移してから消す"
    text household_id
    text actor_user_id
    text action "operationId"
    text target "経路の ID。本文は残さない"
    text detail "変えた項目の名前だけ"
    text at
  }
  audit_anchors {
    text day PK "本体の DB。毎日の基準点の控え"
    integer seq
    text hash
    text at
  }
  audit_events {
    integer seq PK "audit.db（別のファイル、0600）"
    text id UK
    text at
    text household_id
    text actor_user_id
    text action
    text target
    text detail
    text prev_hash
    text hash "SHA-256(prev_hash と正規化した行)"
  }
  audit_checkpoints {
    integer seq PK "audit.db。prune が消す前に残す"
    integer through_seq
    text hash "消した区間の末尾の hash"
    text pruned_before
    integer pruned_rows
    text at
  }
  recovery_codes {
    text user_id PK,FK
    text code_hash PK
    text used_at
  }
  password_resets {
    text id PK
    text user_id FK
    text token_hash UK
    text code_hash
    integer attempts
    text created_at
    text expires_at
    text used_at
  }
  entitlements {
    text household_id PK
    text status
    text ends_at
    text updated_at
  }
  uploads {
    text id PK
    text user_id FK
    text household_id
    text membership_id
    text album_id
    text item_id
    integer upload_length
    integer upload_offset
    integer keep_location
    text expires_at
    text touched_at
  }
  assistant_jobs {
    text id PK
    text household_id
    text user_id
    text kind
    text status
    text file_id
    text result
    text error_code
    text created_at
    text finished_at
  }
  key_fingerprints {
    text kid PK "users.totp_secret の v2.kid から参照"
    text fingerprint "HKDF の指紋。秘密は分からない"
    text created_at
    text retired_at "引退した鍵では署名を確かめない"
  }

  memberships {
    json body "役割、状態、版"
  }
  events {
    json body "予定と繰り返しの規則"
  }
  todos {
    json body "タスク"
  }
  memos {
    json body "メモと添付の情報"
  }
  expenses {
    json body "支出と収入、負担、精算（まとめた精算の記録は batchId を持つ）"
  }
  settlementBatches {
    json body "まとめた精算（id が batchId）。含めた負担と精算の記録 items、実際に渡した送金の一覧 transfers、取り消した時刻 reversedAt"
  }
  resources {
    json body "関連リンク"
  }
  links {
    json body "記録どうしのつながり"
  }
  colorLabels {
    json body "色ラベル"
  }
  invites {
    json body "招待（コードはハッシュ）"
  }
  notifications {
    json body "人ごとの通知"
  }
  permissionOverrides {
    json body "個別の権限"
  }
  albums {
    json body "アルバム"
  }
  albumItems {
    json body "写真と動画の情報。撮影日時 takenAt と出どころ takenAtSource（exif-offset・exif-local・quicktime-key・mvhd）"
  }
  archive {
    json body "archive.events ほか、削除の前の状態"
  }
  meta {
    json body "家族グループ、権限の版、個人の設定"
  }
