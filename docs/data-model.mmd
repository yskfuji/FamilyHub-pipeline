erDiagram
  User ||--o{ HouseholdMembership : belongs_through
  Household ||--o{ HouseholdMembership : has
  HouseholdMembership ||--o{ PermissionOverride : receives
  User ||--o{ Authenticator : registers
  User ||--o{ Session : owns
  Household ||--o{ HouseholdInvite : issues
  HouseholdInvite }o--|| HouseholdMembership : accepted_as
  Household ||--o{ Event : contains
  Household ||--o{ Todo : contains
  Household ||--o{ Memo : contains
  Household ||--o{ Expense : contains
  Household ||--o{ ResourceLink : contains
  Household ||--o{ AuditEvent : records
  Household ||--o{ IdempotencyRecord : deduplicates
  Event ||--o| RecurrenceRule : repeats_by
  Event ||--o{ RecurrenceOverride : excepts
  Todo ||--o| RecurrenceRule : repeats_by
  Todo ||--o{ RecurrenceOverride : excepts
  HouseholdMembership ||--o{ Todo : assigned_to
  HouseholdMembership ||--o{ Todo : reviewed_by
  HouseholdMembership ||--o{ Todo : created_by
  Memo ||--o{ Attachment : has
  Expense ||--|{ ExpenseShare : splits_into
  Expense ||--o{ SettlementRecord : settled_by
  SettlementRecord o|--o| SettlementRecord : reverses
  HouseholdMembership ||--o{ ExpenseShare : owes
  Memo ||--o| PlaceSnapshot : located_at
  Expense ||--o| PlaceSnapshot : located_at
  HouseholdMembership ||--o{ PlaceLookupConsent : grants
  HouseholdMembership ||--o{ Notification : receives

  User {
    uuid id PK
    string email UK
    string display_name
  }
  Household {
    uuid id PK
    string name
    string iana_timezone
    int authorization_revision
  }
  HouseholdMembership {
    uuid id PK
    uuid user_id FK
    uuid household_id FK
    enum role
    enum status
    int version
  }
  PermissionOverride {
    uuid id PK
    uuid membership_id FK
    string capability
    enum effect
  }
  Authenticator {
    uuid id PK
    uuid user_id FK
    enum kind
    bytes credential_public_key
  }
  Session {
    uuid id PK
    uuid user_id FK
    timestamp expires_at
    timestamp revoked_at
  }
  HouseholdInvite {
    uuid id PK
    uuid household_id FK
    enum role
    timestamp expires_at
    int max_uses
    int use_count
  }
  Event {
    uuid id PK
    uuid household_id FK
    timestamp starts_at_utc
    timestamp ends_at_utc
    string timezone
    enum visibility_audience
    json selected_membership_ids
    int version
    timestamp deleted_at
  }
  Todo {
    uuid id PK
    uuid household_id FK
    uuid assignee_membership_id FK
    uuid reviewer_membership_id FK
    uuid creator_membership_id FK
    enum status
    enum visibility_audience
    json selected_membership_ids
    int version
    timestamp deleted_at
  }
  Memo {
    uuid id PK
    uuid household_id FK
    text body
    enum visibility_audience
    json selected_membership_ids
    int version
    timestamp deleted_at
  }
  Attachment {
    uuid id PK
    uuid memo_id FK
    enum scan_status
    int byte_size
  }
  Expense {
    uuid id PK
    uuid household_id FK
    uuid payer_membership_id FK
    int amount_jpy
    date incurred_on
    enum category
    text note
    int version
    timestamp deleted_at
  }
  Notification {
    uuid id PK
    uuid membership_id FK
    enum kind
    string destination
    timestamp remind_at
    enum status
    bool read
  }
  ExpenseShare {
    uuid id PK
    uuid expense_id FK
    uuid membership_id FK
    int amount_jpy
  }
  SettlementRecord {
    uuid id PK
    uuid expense_id FK
    uuid from_membership_id FK
    uuid to_membership_id FK
    uuid reversal_of_id FK
    int amount_jpy
    timestamp recorded_at
  }
  RecurrenceRule {
    uuid id PK
    string rfc5545_rrule
    string timezone
  }
  RecurrenceOverride {
    uuid id PK
    date occurrence_date
    enum action
  }
  ResourceLink {
    uuid id PK
    uuid household_id FK
    string validated_https_url
    enum visibility_audience
    json selected_membership_ids
  }
  PlaceSnapshot {
    uuid id PK
    uuid household_id FK
    string name
    string address
    decimal poi_lat
    decimal poi_lng
    string category
    enum captured_via
    string provider_source
    json licenses
    json attributions
    timestamp selected_at
  }
  PlaceLookupConsent {
    uuid id PK
    uuid membership_id FK
    string notice_version
    timestamp granted_at
    timestamp revoked_at
  }
  AuditEvent {
    uuid id PK
    uuid household_id FK
    uuid actor_membership_id FK
    string action
    timestamp occurred_at
  }
  IdempotencyRecord {
    uuid id PK
    uuid household_id FK
    string key_hash UK
    string request_hash
    int response_status
    timestamp expires_at
  }
