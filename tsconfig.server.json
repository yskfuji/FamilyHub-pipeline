{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/domain/**/*.ts", "src/authz/**/*.ts", "src/content/*.ts", "src/data/gateway.ts"],
  "exclude": ["server/test/**", "server/testing/**", "src/**/*.test.ts", "src/**/*.suite.ts"]
}
